# Copy this file to .env and set a bot token from the Discord Developer Portal.
DISCORD_TOKEN=replace-with-your-discord-bot-token

# Set this during development for fast slash-command registration in one guild.
DEVELOPMENT_GUILD_ID=

# Optional local Ollama support for /ask. It remains disabled by default.
BIGDPP_LLM_ENABLED=false
BIGDPP_LLM_BASE_URL=http://127.0.0.1:11434
BIGDPP_LLM_MODEL=llama3.2
BIGDPP_AI_CHANNEL_NAME=ai-agent
